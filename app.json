{
  "expo": {
    "name": "ShoeSharp",
    "slug": "shoesharp",
    "scheme": "shoesharp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B5D3B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5D3B"
    },
    "ios": {
      "bundleIdentifier": "com.kvyluong.shoesharp",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kvyluong.shoesharp",
      "adaptiveIcon": {
        "backgroundColor": "#0B5D3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "shortName": "ShoeSharp",
      "name": "ShoeSharp"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2452034460168771~8351378637",
          "iosAppId": "ca-app-pub-2452034460168771~4623052468",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver more relevant ads to you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-iap",
      "expo-localization"
    ],
    "extra": {
      "adUnits": {
        "ios": {
          "banner": "ca-app-pub-2452034460168771/1354725442",
          "interstitial": "ca-app-pub-2452034460168771/3392811404",
          "rewarded": "ca-app-pub-2452034460168771/3309970797"
        },
        "android": {
          "banner": "ca-app-pub-2452034460168771/7038296963",
          "interstitial": "ca-app-pub-2452034460168771/1557905422",
          "rewarded": "ca-app-pub-2452034460168771/5189108804"
        }
      },
      "iap": {
        "removeAds": "remove_ads"
      },
      "website": "https://kvyluong.github.io/Black-Jack-APP-STORE",
      "router": {},
      "eas": {
        "projectId": "42b31f8a-cf00-4e18-bce1-beefe9249cee"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "owner": "kvyluong"
  }
}
