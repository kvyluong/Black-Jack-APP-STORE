{
  "expo": {
    "name": "Blackjack Coach",
    "slug": "blackjack-coach",
    "scheme": "blackjackcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B5D3B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B5D3B"
    },
    "ios": {
      "bundleIdentifier": "com.REPLACE_ME.blackjackcoach",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.REPLACE_ME.blackjackcoach",
      "adaptiveIcon": {
        "backgroundColor": "#0B5D3B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "This identifier will be used to deliver more relevant ads to you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-iap",
      "expo-localization"
    ],
    "extra": {
      "adUnits": {
        "ios": {
          "banner": "REPLACE_WITH_IOS_BANNER_UNIT_ID",
          "interstitial": "REPLACE_WITH_IOS_INTERSTITIAL_UNIT_ID",
          "rewarded": "REPLACE_WITH_IOS_REWARDED_UNIT_ID"
        },
        "android": {
          "banner": "REPLACE_WITH_ANDROID_BANNER_UNIT_ID",
          "interstitial": "REPLACE_WITH_ANDROID_INTERSTITIAL_UNIT_ID",
          "rewarded": "REPLACE_WITH_ANDROID_REWARDED_UNIT_ID"
        }
      },
      "iap": {
        "removeAds": "remove_ads"
      },
      "website": "https://kvyluong.github.io/Black-Jack-APP-STORE"
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    }
  }
}
